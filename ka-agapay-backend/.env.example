# =============================================================================
# Ka-Agapay — backend environment template
# =============================================================================
#
# Copy to .env and fill in. NEVER commit a filled-in .env.
#
# This file previously shipped as stock Laravel: it documented MySQL, Pusher,
# AWS and Mailpit — none of which this system uses — and documented none of the
# credentials it actually needs. A clone configured from that version could not
# boot. Everything below reflects what the code really reads.
#
# Full deployment and recovery procedures: docs/OPERATIONS.md
# -----------------------------------------------------------------------------

APP_NAME=Ka-Agapay
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Canonical public root of the API, including scheme. Signed registration
# invite links are SIGNED against this value, so if it disagrees with the URL
# staff actually open, every invite fails signature verification.
APP_URL=http://localhost:8000

# Public origin of the React web admin (rhu-admin). Registration invite links
# are BUILT from this. Required — there is no sensible default.
ADMIN_APP_URL=http://localhost:5173

# Hosts allowed to hold a Sanctum session. The web admin host must appear here
# or admin login fails with a 419.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Production defaults are LOG_CHANNEL=stack + LOG_STACK=daily,slack and
# LOG_LEVEL=warning.
#
# 'daily' rotates and keeps 14 files. The old 'single' default was ONE file that
# never rotated, which is the usual way this droplet's disk fills up.
#
# Listing 'slack' with LOG_SLACK_WEBHOOK_URL unset is safe and verified: the
# slack handler is skipped, nothing throws, and 'daily' still receives every
# record. Set the webhook to switch alerting on — no code change needed.
LOG_CHANNEL=stack
LOG_STACK=daily,slack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Create an Incoming Webhook in Slack (or a compatible service) and paste the
# URL here. Leave blank until then.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=Ka-Agapay
# Chat alerts are noisier than a log file. Start at warning; raise to 'error'
# if the channel gets ignored. Backup failures log at error, so they arrive
# at either setting.
LOG_SLACK_LEVEL=warning

# -----------------------------------------------------------------------------
# Database — PostgreSQL (NOT MySQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ka_agapay
DB_USERNAME=
DB_PASSWORD=
# Set to 'require' when the database is not on localhost.
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Database backups  (see docs/deploy/kaagapay-backup.sh)
# -----------------------------------------------------------------------------
# Where `php artisan backup:run` writes dumps. Must be writable by the user in
# the crontab.
BACKUP_PATH=/var/backups/kaagapay

# How many days of dump FILES to keep on the droplet. Disk hygiene only — it
# never deletes backup_runs rows, so the record of what ran always survives.
BACKUP_KEEP_DAYS=14

# Set true once the cron wrapper is actually shipping dumps off the droplet.
# While false, runs are honestly recorded as offsite_status='skipped' instead
# of appearing protected.
BACKUP_OFFSITE_ENABLED=false

# Only if PostgreSQL client tools are not on cron's PATH. A version mismatch
# between pg_dump and the server aborts the dump — keep them in step.
# BACKUP_PG_DUMP_BIN=/usr/bin/pg_dump

# Hours before the Settings > Backup panel calls the last good backup overdue.
BACKUP_STALE_AFTER_HOURS=36

# -----------------------------------------------------------------------------
# Framework
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# AI chat assistant — Google Gemini
# -----------------------------------------------------------------------------
# Key from Google AI Studio. Verify with: php artisan gemini:test-key
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# SMS — Semaphore (Philippines)
# -----------------------------------------------------------------------------
# Dominant recurring cost. Sending silently stops when the balance runs out;
# check GET /api/v1/admin/sms/account.
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
# Must be pre-registered with Semaphore or messages are rejected.
SEMAPHORE_SENDERNAME=KAAGAPAY
SEMAPHORE_BASE_URL=https://api.semaphore.co/api/v4

# -----------------------------------------------------------------------------
# OCR — OCR.space
# -----------------------------------------------------------------------------
# Used for PhilHealth ID and employee-ID extraction.
OCR_SPACE_API_KEY=

# -----------------------------------------------------------------------------
# Video calling — 8x8 JaaS (telemedicine AND Team Chat share one signer)
# -----------------------------------------------------------------------------
# Misconfiguration here fails by HANGING at "joining", not by erroring, so
# verify explicitly after any change:  php artisan jitsi:doctor
JITSI_PROVIDER=jaas
JITSI_DOMAIN=8x8.vc
# JaaS rejects unauthenticated joins — leave true in production.
JITSI_JWT_ENABLED=true
# Tenant/app id. Becomes the JWT 'sub' and the room-name namespace prefix.
JITSI_APP_ID=
# API key ID. Becomes the JWT 'kid' header. Alias: JITSI_API_KEY_ID.
JITSI_API_KEY=
# Either an absolute path to the RS256 private key PEM, or the inline PEM.
# The file should be 0400/0600 and owned by the php-fpm user.
# Alias: the path may instead be left in JITSI_APP_SECRET.
JITSI_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Mail — only used for framework defaults; the system notifies by SMS and push.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@kaagapay.local
MAIL_FROM_NAME="${APP_NAME}"
